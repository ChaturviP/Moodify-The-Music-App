<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- Avatar -->
        <androidx.cardview.widget.CardView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="55dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/profile_circle"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_myplaces"/>
        </androidx.cardview.widget.CardView>

        <!-- Name -->
        <TextView
            android:id="@+id/profileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moodify User"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_gravity="center"
            android:layout_marginTop="18dp" />

        <!-- Email -->
        <TextView
            android:id="@+id/profileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user@email.com"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/profileBio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No bio yet"
            android:layout_gravity="center"
            android:textSize="14sp"/>
        <!-- Joined -->
        <TextView
            android:id="@+id/joinedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Joined Moodify"
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:layout_gravity="center"
            android:layout_marginTop="6dp" />

        <!-- Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="30dp">

            <!-- Favorites -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="@color/card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/favStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Favorites"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Playlists -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="@color/card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playlistStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Playlists"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Options -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <Button
                    android:id="@+id/editProfileBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit Profile"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/myPlaylistsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="My Playlists"
                    android:textStyle="bold"
                    android:padding="12dp"/>

                <TextView
                    android:id="@+id/likedSongsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Liked Songs"
                    android:textStyle="bold"
                    android:padding="12dp"/>

                <TextView
                    android:id="@+id/historyBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Listening History"
                    android:textStyle="bold"
                    android:padding="12dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Logout -->
        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="34dp"
            android:text="Logout"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="@color/primary" />

    </LinearLayout>

</ScrollView>